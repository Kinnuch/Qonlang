{
  "name": "qonlang",
  "version": "0.6.6",
  "description": "千语集 Qonlang — a workbench for every conlanger: lexicon, sound changes, phonology, paradigms, glossing.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Kinnuch"
  },
  "homepage": "https://kinnuch.github.io/cerf/qonlang/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kinnuch/Qonlang.git"
  },
  "scripts": {
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "pack:win": "bash scripts/pack-win.sh",
    "installer:win": "bash scripts/pack-win.sh && electron-builder --win nsis --prepackaged dist/win-unpacked",
    "installer:mac": "npm run build && electron-builder --mac --publish never",
    "release": "node scripts/release.mjs",
    "fetch:release": "node scripts/fetch-release.mjs",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.web.json",
    "examples": "esbuild scripts/make-examples.ts --bundle --platform=node --format=esm --alias:$lib=./src/renderer/src/lib --outfile=dist/make-examples.mjs && node dist/make-examples.mjs",
    "diag:kessar": "esbuild scripts/diag-kessar.ts --bundle --platform=node --format=cjs --alias:$lib=./src/renderer/src/lib --outfile=dist/diag-kessar.cjs && node dist/diag-kessar.cjs",
    "diag:gloss": "esbuild scripts/diag-gloss.ts --bundle --platform=node --format=cjs --alias:$lib=./src/renderer/src/lib --outfile=dist/diag-gloss.cjs && node dist/diag-gloss.cjs",
    "examples:theusrin": "esbuild scripts/make-theusrin.ts --bundle --platform=node --format=cjs --alias:$lib=./src/renderer/src/lib --outfile=dist/make-theusrin.cjs && node dist/make-theusrin.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lucide/svelte": "^1.42.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/node": "^22.19.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.0"
  },
  "license": "MIT"
}
